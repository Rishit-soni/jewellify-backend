              "raw": "{{base_url}}/api/dashboard/summary",
              "host": ["{{base_url}}"],
              "path": ["api", "dashboard", "summary"]
            },
            "description": "Get comprehensive dashboard summary including:\n- User details (name, email, role)\n- Tenant/Business details (business name, owner, contact info)\n- Total stock value\n- Today's sales\n- Pending payments\n- Weekly revenue chart (last 7 days)\n- Top 5 selling items\n- Category statistics (item count per category)"
          }
