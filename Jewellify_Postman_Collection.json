      "item": [
        {
          "name": "Register Tenant 1 (Store 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.tenant && jsonData.tenant.id) {",
                  "    pm.collectionVariables.set(\"tenant_id\", jsonData.tenant.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"Admin User\",\n  \"email\": \"admin@store1.com\",\n  \"password\": \"password123\",\n  \"role\": \"Admin\",\n  \"businessName\": \"Golden Jewels Store\",\n  \"ownerName\": \"John Doe\",\n  \"phone\": \"9876543210\",\n  \"address\": \"123 Main Street, City\",\n  \"gstNumber\": \"GST1234567890\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
