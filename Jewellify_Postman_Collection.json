            "url": {
              "raw": "{{base_url}}/api/items/{{item_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "items", "{{item_id}}"]
            }
          }
        },
        {
          "name": "Create Item - Gold Necklace (Auto-generated code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"item_id\", jsonData.item._id);",
                  "pm.test(\"Item code auto-generated with GN prefix\", function () {",
                  "    pm.expect(jsonData.item.itemCode).to.match(/^GN\\d{2}$/);",
                  "});",
                  "",
                  "pm.test(\"Category validation passed\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.item.category).to.eql(\"Gold Necklace\");",
                  "});",
                  "",
                  "pm.test(\"Other charges are stored correctly\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.item.otherCharges).to.be.an('array');",
                  "    pm.expect(jsonData.item.otherCharges).to.have.lengthOf(2);",
                  "    pm.expect(jsonData.item.otherCharges[0]).to.have.property('name', 'Rhodium');",
                  "    pm.expect(jsonData.item.otherCharges[0]).to.have.property('amount', 200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Gold Necklace for Ladies"
                },
                {
                  "key": "description",
                  "value": "Beautiful 18k gold necklace"
                },
                {
                  "key": "category",
                  "value": "Gold Necklace",
                  "description": "Category must exist in the system. Create categories first using Categories endpoints."
                },
                {
                  "key": "grossWeight",
                  "value": "25.5"
                },
                {
                  "key": "netWeight",
                  "value": "22.8"
                },
                {
                  "key": "source",
                  "value": "Local Supplier"
                },
                {
                  "key": "huid",
                  "value": "HUID123456"
                },
                {
                  "key": "labour.mode",
                  "value": "fixed_amount"
                },
                {
                  "key": "labour.amount",
                  "value": "500"
                },
                {
                  "key": "otherCharges",
                  "value": "[{\"name\":\"Rhodium\",\"amount\":200},{\"name\":\"Diamonds\",\"amount\":4000}]",
                  "description": "Array of additional charges as JSON string. Each charge has 'name' and 'amount' fields."
                },
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/items",
              "host": ["{{base_url}}"],
              "path": ["api", "items"]
            },
            "description": "Create item with category validation and other charges. Item code prefix is auto-generated from category name. Gold Necklace -> GN01, GN02, etc. Category must exist before creating items. Other charges can include Rhodium, Diamonds, Labor, etc."
          }
        },
