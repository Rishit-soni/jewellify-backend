    {
      "name": "Items",
      "item": [
        {
          "name": "Get All Items (with Pagination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response includes items array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('items');",
                  "    pm.expect(jsonData.items).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Items have category as string field\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.items.length > 0) {",
                  "      pm.expect(jsonData.items[0]).to.have.property('category');",
                  "      pm.expect(jsonData.items[0].category).to.be.a('string');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/items?page=1&limit=10&search=gold&category=Gold Necklace&sortBy=createdAt&sortOrder=desc",
              "host": ["{{base_url}}"],
              "path": ["api", "items"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "search",
                  "value": "gold"
                },
                {
                  "key": "category",
                  "value": "Gold Necklace"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                }
              ]
            },
            "description": "Get all items with pagination and filtering. Category field is returned as a string. Use separate Categories endpoints to get available categories."
          }
        },
        {
          "name": "Get Item by ID",
          "request": {
            "method": "GET",
            "header": [
